Host github.com
    User git
    IdentityAgent {{ if and (eq .chezmoi.os "darwin") (glob "/Applications/Bitwarden.app/Contents/_MASReceipt/receipt") }}~/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock{{ else }}~/.bitwarden-ssh-agent.sock{{ end }}

{{ if eq .profile "corporate" -}}
{{ include ".private/ssh.age" | decrypt }}
{{ end -}}
Host *
    Include {{ joinPath .chezmoi.homeDir ".ssh" "config.local" | quote }}
