{{ if ne .profile "config" -}}
{{ if ne .profile "minimal" -}}
#!/bin/sh
set -eu
{{ if eq .chezmoi.os "linux" -}}
for variant in main dawn; do
  if ! unopkg list --shared "org.rosepine.libreoffice.$variant" >/dev/null 2>&1; then
    sudo unopkg add --shared --suppress-license \
      "$HOME/.local/share/themes/rose-pine-libreoffice/rose-pine-$variant.oxt"
  fi
done
anki_addon="$HOME/.local/share/Anki2/addons21/688199788"
{{ else -}}
anki_addon="$HOME/Library/Application Support/Anki2/addons21/688199788"
{{ end -}}
if [ ! -f "$anki_addon/__init__.py" ] && [ -f "$(dirname "$anki_addon")/ReColor/__init__.py" ]; then
  anki_addon="$(dirname "$anki_addon")/ReColor"
fi
if [ -f "$anki_addon/__init__.py" ]; then
  mkdir -p "$anki_addon/themes"
  cp "$HOME/.local/share/themes/rose-pine-anki/"*.json "$anki_addon/themes/"
else
  printf '%s\n' 'Anki theme files staged; install ReColor in Anki, then apply again. See README Post-deploy.'
fi
{{ end -}}
{{ end -}}
