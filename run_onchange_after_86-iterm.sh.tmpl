{{ if ne .profile "config" -}}
{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu
{{ $settings := include "packages/iterm-ui.json" | fromJson -}}
{{ range $key, $setting := $settings -}}
defaults write com.googlecode.iterm2 {{ $key | quote }} -{{ $setting.type }} {{ if eq $setting.type "boolean" }}{{ if eq $setting.value "1" }}true{{ else }}false{{ end }}{{ else }}{{ $setting.value | quote }}{{ end }}
{{ end -}}

mkdir -p "$HOME/.local/share/themes/rose-pine-iterm-custom"
preset="$HOME/.local/share/themes/rose-pine-iterm-custom/rose-pine-contrast.itermcolors"
cp "$HOME/.local/share/themes/rose-pine-iterm/rose-pine.itermcolors" "$preset"
/usr/libexec/PlistBuddy -c 'Set :Cursor\ Color:Red\ Component 0.8784313725' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Cursor\ Color:Green\ Component 0.8705882353' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Cursor\ Color:Blue\ Component 0.9568627451' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Cursor\ Text\ Color:Red\ Component 0.0980392157' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Cursor\ Text\ Color:Green\ Component 0.0901960784' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Cursor\ Text\ Color:Blue\ Component 0.1411764706' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Selection\ Color:Red\ Component 0.3843137255' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Selection\ Color:Green\ Component 0.3686274510' "$preset"
/usr/libexec/PlistBuddy -c 'Set :Selection\ Color:Blue\ Component 0.4784313725' "$preset"

python3 - <<'PYTHON'
import plistlib
import subprocess

settings = plistlib.loads(subprocess.check_output(["defaults", "export", "com.googlecode.iterm2", "-"]))
profiles = settings.get("New Bookmarks", [])
changed = False
for profile in profiles:
    if profile.get("Use Separate Colors for Light and Dark Mode"):
        key = "Selection Color (Dark)"
    else:
        background = profile.get("Background Color", {})
        if max(background.get(component + " Component", 1) for component in ("Red", "Green", "Blue")) > 0.5:
            continue
        key = "Selection Color"
    color = {"Red Component": 98 / 255, "Green Component": 94 / 255, "Blue Component": 122 / 255,
             "Alpha Component": 1.0, "Color Space": "sRGB"}
    if profile.get(key) != color:
        profile[key] = color
        changed = True
if changed:
    subprocess.run(["defaults", "write", "com.googlecode.iterm2", "New Bookmarks", "-array",
                    *(plistlib.dumps(profile).decode() for profile in profiles)], check=True)
PYTHON
{{ end -}}
{{ end -}}
