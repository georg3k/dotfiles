{{- $profile := promptChoiceOnce . "profile" "Setup profile" (list "personal" "corporate" "minimal" "config") "personal" -}}
{{- if not (has $profile (list "personal" "corporate" "minimal" "config")) -}}
{{- fail "profile must be personal, corporate, minimal or config" -}}
{{- end -}}
{{- if and (eq $profile "corporate") (ne .chezmoi.os "darwin") -}}
{{- fail "corporate is macOS-only; use personal or minimal on Ubuntu" -}}
{{- end -}}
{{- if and (eq $profile "minimal") (ne .chezmoi.os "linux") -}}
{{- fail "minimal is Linux-only" -}}
{{- end -}}
{{ if not (has $profile (list "minimal" "config")) -}}
encryption = "age"

[age]
identity = {{ joinPath .chezmoi.homeDir ".config/chezmoi/age-key.txt" | quote }}
recipient = "age1zugzlfsl6slsmz6yvnwkruj3tl6y5w8yxr0dvzzf0tpxeyg96qrqafjped"

{{ end -}}
[gitHub]
refreshPeriod = "24h"

[data]
profile = {{ $profile | quote }}
