{{ if ne .profile "minimal" -}}
#!/bin/sh
set -eu
{{ if eq .chezmoi.os "darwin" -}}
export PATH="/Applications/Visual Studio Code.app/Contents/Resources/app/bin:$PATH"
{{ end -}}
if ! command -v code >/dev/null 2>&1; then
  printf '%s\n' 'VS Code must be installed before installing its extensions.' >&2
  exit 1
fi
{{ range .vscodeExtensions -}}
{{ if not (regexMatch "^[A-Za-z0-9_-]+[.][A-Za-z0-9_.-]+$" .) }}{{ fail "Use a publisher.extension ID" }}{{ end -}}
code --install-extension {{ . | quote }}
{{ end -}}

{{ if (eq .profile "corporate") -}}
# A profile is a convenience boundary, not a security sandbox.
if ! code --profile Corporate --list-extensions >/dev/null 2>&1; then
  code --profile Corporate --new-window
  attempts=0
  until code --profile Corporate --list-extensions >/dev/null 2>&1; do
    attempts=$((attempts + 1))
    if [ "$attempts" -ge 30 ]; then
      printf '%s\n' 'VS Code could not create the Corporate profile. Open it once, then apply again.' >&2
      exit 1
    fi
    sleep 1
  done
fi
{{ range .vscodeExtensions -}}
code --profile Corporate --install-extension {{ . | quote }}
{{ end -}}
{{ include ".private/editor-private.age" | decrypt }}
{{ end -}}
{{ end -}}
