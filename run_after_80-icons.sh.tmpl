{{ if and (eq .chezmoi.os "linux") (ne .profile "minimal") -}}
#!/bin/sh
set -eu
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  exec dbus-run-session -- sh "$0"
fi
bash "$HOME/.local/share/tela-circle-source/install.sh" -d "$HOME/.local/share/icons" standard
gsettings set org.gnome.desktop.interface icon-theme 'Tela-circle'
{{ end -}}
